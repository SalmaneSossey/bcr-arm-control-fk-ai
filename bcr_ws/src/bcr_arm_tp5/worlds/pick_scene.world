<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pick_scene">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.78 0.84 0.90 1</background>
    </scene>

    <light name="key_light" type="directional">
      <pose>0 0 4 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.55 0.57 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.50 0 0.40 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision">
          <geometry>
            <box>
              <size>0.60 0.60 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="top_visual">
          <geometry>
            <box>
              <size>0.60 0.60 0.05</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.62 0.47 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="target_cup">
      <static>false</static>
      <pose>0.45 0.10 0.48 0 0 0</pose>
      <link name="cup_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.12 0.45 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
